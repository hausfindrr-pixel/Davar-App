rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    match /users/{uid} {
      allow read: if isOwner(uid);
      // `tier`, `premiumSince`, `premiumUntil`, and `planId` can only ever
      // start at "free"/null/null/null, and can never be changed by the
      // client afterward — nothing client-side should be able to grant
      // itself "premium" or a fake plan. Only the Plisio webhook and the
      // daily expiry cron, both writing via the Admin SDK (which bypasses
      // these rules), can change them.
      allow create: if isOwner(uid) &&
        request.resource.data.uid == uid &&
        request.resource.data.tier == "free" &&
        request.resource.data.premiumSince == null &&
        request.resource.data.premiumUntil == null &&
        request.resource.data.planId == null;
      allow update: if isOwner(uid) &&
        request.resource.data.tier == resource.data.tier &&
        request.resource.data.premiumSince == resource.data.premiumSince &&
        request.resource.data.premiumUntil == resource.data.premiumUntil &&
        request.resource.data.planId == resource.data.planId;
      allow delete: if false;
    }

    // A user's own free-text prayer journal. docId is auto-generated
    // client-side (doc() with no ID); ownership comes from the uid path
    // segment, same pattern as conversations/{uid}/messages. Unlike that
    // collection, the client writes directly here (no server-side routing
    // logic to protect) — but entries are immutable once created: no
    // update/delete for v1, this is a journal, not an editable note.
    match /users/{uid}/prayers/{prayerId} {
      allow read: if isOwner(uid);
      allow create: if isOwner(uid) &&
        request.resource.data.id == prayerId &&
        request.resource.data.text is string &&
        request.resource.data.text.size() > 0 &&
        request.resource.data.text.size() <= 2000;
      allow update, delete: if false;
    }

    match /streaks/{uid} {
      allow read, write: if isOwner(uid);
    }

    match /check_ins/{checkInId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if false;
    }

    match /lessons/{lessonId} {
      allow read: if isSignedIn();
      allow write: if false; // managed via the console or the Admin SDK
    }

    // Free-tier daily lesson cap. docId is "{uid}_{date}" — one doc per
    // user per day, so a new day naturally starts a fresh count. The real
    // enforcement is here, not in the client: completeLesson() (see
    // src/lib/db/lessons.ts) checks the limit client-side too for a clean
    // UX, but if that check were bypassed, growing completedLessonIds past
    // FREE_DAILY_LESSON_LIMIT (3) below rejects the whole transaction for
    // a non-premium user — including the XP award and check-in write that
    // ride along with it in the same transaction.
    //
    // Known limitation: `date` is client-supplied, same as lastCheckInDate
    // on streaks/{uid} — a client forging an arbitrary date could start a
    // fresh counter early. This stops casual bypass (refreshing the page,
    // clearing local state) but not a client deliberately forging writes;
    // closing that fully needs server-trusted time (e.g. a Cloud Function).
    match /daily_lesson_progress/{docId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;

      allow create: if isSignedIn() &&
        request.resource.data.userId == request.auth.uid &&
        docId == request.auth.uid + '_' + request.resource.data.date &&
        request.resource.data.completedLessonIds.size() == 1;

      allow update: if isSignedIn() &&
        resource.data.userId == request.auth.uid &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.date == resource.data.date &&
        request.resource.data.completedLessonIds.size() ==
          resource.data.completedLessonIds.size() + 1 &&
        request.resource.data.completedLessonIds.hasAll(resource.data.completedLessonIds) &&
        (
          resource.data.completedLessonIds.size() < 3 ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.tier == "premium"
        );

      allow delete: if false;
    }

    match /accountability_links/{linkId} {
      allow read, update: if isSignedIn() &&
        (resource.data.userId == request.auth.uid ||
         resource.data.partnerId == request.auth.uid);
      allow create: if isSignedIn() && request.resource.data.initiatedBy == request.auth.uid;
      allow delete: if false;
    }

    // The Word's verse highlights. docId is derived from uid + reference
    // ("{uid}_{book}_{chapter}_{verse}") so a user can only ever have one
    // highlight per verse — re-highlighting with a new color overwrites it
    // (an "update" in rules terms) rather than creating a duplicate.
    match /user_highlights/{highlightId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create, update: if isSignedIn() &&
        request.resource.data.userId == request.auth.uid &&
        highlightId == request.auth.uid + '_' + request.resource.data.book + '_' +
          string(request.resource.data.chapter) + '_' + string(request.resource.data.verse);
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    // Peter's Watch AI chat. docId path is conversations/{uid}/messages/{id}
    // — ownership comes from the uid path segment itself, not a data field.
    // Read-only for clients: only the Admin SDK (via /api/watch-chat, which
    // runs crisis-detection and apostle-routing server-side before writing
    // anything) ever creates these docs, so that logic can't be bypassed by
    // writing straight to Firestore.
    match /conversations/{uid}/messages/{messageId} {
      allow read: if isOwner(uid);
      allow write: if false;
    }

    // Today tab's app-provided daily content — three separate pools kept
    // structurally distinct from `lessons` so Today and The Path never
    // draw from the same content on a given day. Read-only for clients,
    // same as `lessons`: managed via the console or the Admin SDK.
    match /daily_verses/{id} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    match /daily_devotionals/{id} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    match /daily_prayers/{id} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // Peter's Watch's daily message-limit counter. Purely a server-side
    // implementation detail of /api/watch-chat (Admin SDK only, which
    // bypasses these rules entirely) — the client never reads or writes
    // it directly, so there's nothing to allow here. It reads whether
    // today's cap has already been hit off the conversation history
    // instead (see the `limitReached` flag on ConversationMessageDoc).
    match /watch_chat_usage/{docId} {
      allow read, write: if false;
    }
  }
}
